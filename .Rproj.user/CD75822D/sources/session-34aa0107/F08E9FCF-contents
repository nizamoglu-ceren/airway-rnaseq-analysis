# Paketleri yükle
library(EnhancedVolcano)
library(DESeq2)
library(airway)
library(org.Hs.eg.db)
library(pheatmap)
data(airway)
airway
# 2) Kaç gen ve kaç örnek var?
dim(airway)
# 3) Örnekler hakkında bilgi (hangisi ilaçlı, hangisi ilaçsız?)
colData(airway)
# 4) Gen sayım tablosunun ilk birkaç satırı
head(assay(airway))
# 5) Her örnekte toplam kaç okuma var? (dizileme derinliği)
colSums(assay(airway))
# 6) Kontrol grubunu referans olarak ayarla
# (karşılaştırma "ilaçlı, ilaçsıza göre" olsun diye)
airway$dex <- relevel(airway$dex, ref = "untrt")
library(DESeq2)
dds <- DESeqDataSet(airway, design = ~ cell + dex)
# 8) Neredeyse hiç okunmayan genleri çıkar
keep <- rowSums(counts(dds)) >= 10
dds <- dds[keep, ]
# Kaç gen kaldı?
nrow(dds)
# 9) Diferansiyel ekspresyon analizini çalıştır
dds <- DESeq(dds)

# 10) Sonuçları al: ilaçlı vs ilaçsız
res <- results(dds)

# 11) Sonuçların özeti
summary(res)

# 12) Daha sıkı eşikle sonuçları tekrar al (padj < 0.05)
res <- results(dds, alpha = 0.05)
summary(res)

# 13) Sonuçları en anlamlıdan aza doğru sırala
resOrdered <- res[order(res$padj), ]

# 14) En anlamlı ilk 10 geni göster
head(resOrdered, 10)
# 15) Ensembl kodlarını gen isimlerine çevir
res$symbol <- mapIds(org.Hs.eg.db,
                     keys = rownames(res),
                     column = "SYMBOL",
                     keytype = "ENSEMBL",
                     multiVals = "first")

# 16) Tekrar sırala ve ilk 10 geni isimleriyle göster
resOrdered <- res[order(res$padj), ]
head(resOrdered[, c("symbol", "log2FoldChange", "padj")], 10)
# 17) Sonuçları bir dosyaya kaydet
dir.create("results", showWarnings = FALSE)
write.csv(as.data.frame(resOrdered), "results/deseq2_results.csv")

# 18) Orijinal makalenin öne çıkardığı gen: CRISPLD2
resOrdered[which(resOrdered$symbol == "CRISPLD2"),
           c("symbol", "log2FoldChange", "padj")]
# 19) Görselleştirme için veriyi dönüştür
vsd <- vst(dds, blind = FALSE)

# 20) PCA grafiği
dir.create("figures", showWarnings = FALSE)
pca_plot <- plotPCA(vsd, intgroup = "dex")
pca_plot
plotPCA(vsd, intgroup = "cell")

# 21) Grafiği dosyaya kaydet
ggplot2::ggsave("figures/pca_plot.png", pca_plot, width = 6, height = 5)

# 22) Volcano plot için p-değeri olmayan genleri çıkar
res_plot <- res[!is.na(res$padj), ]

# 23) Etiketlenecek genleri seç: en anlamlı 8 artan ve 8 azalan gen
sig <- res_plot[res_plot$padj < 0.05 & !is.na(res_plot$symbol), ]
sig <- sig[order(sig$padj), ]
up_genes   <- head(sig$symbol[sig$log2FoldChange > 1], 8)
down_genes <- head(sig$symbol[sig$log2FoldChange < -1], 8)
label_genes <- c(up_genes, down_genes, "CRISPLD2")

# 24) Volcano plot
volcano <- EnhancedVolcano(res_plot,
                           lab = res_plot$symbol,
                           x = "log2FoldChange",
                           y = "padj",
                           selectLab = label_genes,
                           pCutoff = 0.05,
                           FCcutoff = 1,
                           pointSize = 1.5,
                           labSize = 3.5,
                           drawConnectors = TRUE,
                           widthConnectors = 0.4,
                           max.overlaps = Inf,
                           legendPosition = "right",
                           ylab = bquote(~-Log[10] ~ "adjusted" ~ italic(P)),
                           title = "Dexamethasone vs Control",
                           subtitle = "Human airway smooth muscle cells")
volcano

# 25) Kaydet
ggplot2::ggsave("figures/volcano_plot.png", volcano, width = 10, height = 8)

# 26) En anlamlı 30 geni seç
top30 <- head(rownames(resOrdered), 30)
mat <- assay(vsd)[top30, ]

# 27) Her geni kendi ortalamasına göre ortala
mat <- mat - rowMeans(mat)

# 28) Satır adlarını gen isimleriyle değiştir
gene_names <- resOrdered[top30, "symbol"]
rownames(mat) <- ifelse(is.na(gene_names), top30, gene_names)

# 29) Örnek bilgilerini hazırla (üstteki renkli şeritler için)
anno <- as.data.frame(colData(vsd)[, c("dex", "cell")])

# 30) Heatmap çiz ve kaydet
pheatmap(mat, annotation_col = anno)
pheatmap(mat, annotation_col = anno,
         filename = "figures/heatmap_top30.png", width = 7, height = 9)

# 31) Kullanılan R ve paket sürümlerini kaydet
writeLines(capture.output(sessionInfo()), "results/session_info.txt")